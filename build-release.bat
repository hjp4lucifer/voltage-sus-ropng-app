@echo off
title release 打包环境

rem =====================================================================
rem  release APK 打包启动脚本 (launcher)
rem  功能: 加载 JDK8 环境, 并打开新的 CMD 窗口执行打包
rem  说明:
rem    1. 使用 JAVA_HOME_8 指定的 JDK8 环境(不校验, 校验在 core 中)
rem    2. 打开新的 CMD 窗口并切换到项目目录, 窗口保持打开
rem    3. 新窗口中手动执行 build-release-core.bat 完成打包
rem  用法: 双击本脚本, 然后在新窗口中执行 build-release-core.bat
rem =====================================================================

rem ---- 定位项目根目录(脚本所在目录) ----
set "PROJECT_DIR=%~dp0"

rem =====================================================================
rem 1. 加载 JDK8 环境
rem =====================================================================
set "JAVA_HOME=%JAVA_HOME_8%"
set "PATH=%JAVA_HOME_8%\bin;%PATH%"

rem =====================================================================
rem 2. 提示可用命令
rem =====================================================================
echo ----------------------------------------
echo Switched to JDK8 Environment!
echo JAVA_HOME=%JAVA_HOME_8%
echo ----------------------------------------
echo.
echo 可用启动命令：
echo   打包 release：build-release-core.bat
echo ----------------------------------------
echo.

rem =====================================================================
rem 3. 打开新的 CMD 窗口并切换到项目目录
rem    cmd /k 保持窗口打开; /d 用于跨盘符切换
rem =====================================================================
cmd /k "cd /d %PROJECT_DIR%"
